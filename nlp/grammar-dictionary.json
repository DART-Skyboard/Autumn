  "vowels": {
    "primary": ["a","e","i","o","u"],
    "extended_en": ["ae","ai","ao","au","ea","ee","ei","eu","ia","ie","io","oa","oe","oi","oo","ou","ua","ue","ui","uo"],
    "buoyancy_weight": {
      "a": 1.0, "e": 0.92, "i": 0.84, "o": 0.76, "u": 0.68,
      "note": "Descending weight mirrors LEATR tool order - open vowels carry highest buoyancy"
    },
    "emotional_resonance": {
      "a": ["assertive","direct","grounding"],
      "e": ["expressive","relational","aware"],
      "i": ["introspective","precise","analytical"],
      "o": ["open","communal","empathetic"],
      "u": ["uncertain","searching","transitional"]
    }
  },

  "consonants": {
    "by_class": {
      "stops": ["p","b","t","d","k","g"],
      "fricatives": ["f","v","s","z","sh","zh","h","th"],
      "nasals": ["m","n","ng"],
      "liquids": ["l","r"],
      "affricates": ["ch","j"],
      "approximants": ["w","y"]
    },
    "tool_affinity": {
      "stops":      { "tool": "HAMMER",   "index": 4, "reason": "Impact / force phonetics" },
      "fricatives": { "tool": "KNIFE",    "index": 6, "reason": "Cutting / dividing phonetics" },
      "nasals":     { "tool": "ENVELOPE", "index": 3, "reason": "Containing / resonant phonetics" },
      "liquids":    { "tool": "STICK",    "index": 5, "reason": "Flow / extension phonetics" },
      "affricates": { "tool": "SCISSORS", "index": 7, "reason": "Dual-action phonetics" },
      "approximants":{ "tool": "MAZE",   "index": 1, "reason": "Orientation / pathway phonetics" }
    }
  },

  "punctuation": {
    "markers": {
      ".":  { "id": "P_PERIOD",    "signal": "declarative_end",   "emotion_bias": "neutral",    "tool_trigger": "ENVELOPE" },
      "?":  { "id": "P_QUESTION",  "signal": "interrogative",     "emotion_bias": "curious",    "tool_trigger": "PUZZLE" },
      "!":  { "id": "P_EXCLAIM",   "signal": "emphatic",          "emotion_bias": "intense",    "tool_trigger": "HAMMER" },
      ",":  { "id": "P_COMMA",     "signal": "clause_link",       "emotion_bias": "sequential", "tool_trigger": "STICK" },
      ";":  { "id": "P_SEMI",      "signal": "compound_join",     "emotion_bias": "analytical", "tool_trigger": "KNIFE" },
      ":":  { "id": "P_COLON",     "signal": "elaboration",       "emotion_bias": "explanatory","tool_trigger": "MAZE" },
      "...":{ "id": "P_ELLIPSIS",  "signal": "trailing_thought",  "emotion_bias": "uncertain",  "tool_trigger": "SCISSORS" },
      "-":  { "id": "P_DASH",      "signal": "aside_interject",   "emotion_bias": "reflective", "tool_trigger": "SCISSORS" },
      "\"": { "id": "P_QUOTE",     "signal": "attribution",       "emotion_bias": "referential","tool_trigger": "ENVELOPE" }
    },
    "density_scoring": {
      "note": "Count punctuation marks per 100 chars. High density = Knife/Scissors dominant. Low density = Maze/Hammer dominant.",
      "low_0_2":    "MAZE / HAMMER dominant — direct, grounded, action-oriented",
      "mid_3_5":    "PUZZLE / ENVELOPE dominant — analytical, structured",
      "high_6_plus":"KNIFE / SCISSORS dominant — nuanced, layered, reflective"
    }
  },

